# ============================================
# AI20K Project â€” Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values:
# Linux/macOS: cp .env.example .env
# Windows: copy .env.example .env
#
# Khởi động hệ thống:
# 1. Chạy PostgreSQL: docker-compose up -d postgres
# 2. Khởi tạo tài khoản: Đăng ký trực tiếp trên giao diện hoặc dùng script backend
# NEVER commit your actual .env to git!

# ---- 1. Application Configuration ----
APP_NAME="AI20K Agent System"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# ---- 2. Database Configuration (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai20k_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai20k_db

# ---- 3. Redis Configuration ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 4. Security Configuration ----
SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- 5. LLM Configuration ----
# [Option A] Local LLM (Ollama - e.g., Qwen2.5-Coder 14B / Gemma 2 9B / Mistral NeMo 12B)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=qwen2.5-coder:14b

# [Option B] Cloud LLM (OpenAI / OpenRouter / Google Gemini)
OPENAI_API_KEY=your-openai-or-openrouter-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GOOGLE_API_KEY=your-google-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
MAX_TOKENS=3000

# [Option B] Cloud LLM (OpenAI / OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_API_KEY=
MODEL_NAME=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
# Thời gian chờ tối đa một lời gọi LLM (giây) — NFR2 yêu cầu re-prompt dưới 15 giây
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---- 6. Agent Operation Configuration ----
# Trần token cho một operation — phải đủ lớn để xuất trọn schema JSON/DBML.
AGENT_MAX_OUTPUT_TOKENS=8000
# Che thông tin cá nhân trước khi gửi lên LLM (FR6.2) — chỉ tắt khi cần gỡ lỗi
PII_MASKING_ENABLED=true
PII_DEFAULT_LANGUAGE=vi
PII_SUPPORTED_LANGUAGES=vi,en,ja
PII_SCORE_THRESHOLD=0.4

# ---- 7. Observability Configuration ----
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent

# ---- 8. CORS Configuration ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key
AI_LOG_DIR=.ai-log
